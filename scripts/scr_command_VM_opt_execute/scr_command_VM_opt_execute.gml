	var _c2 = _all_cols ? global.grid_cols - 1 : _c1;
	var _r1 = _all_rows ? 0 : clamp(_row, 0, global.grid_rows - 1);
	var _r2 = _all_rows ? global.grid_rows - 1 : _r1;
	for (var _c = _c1; _c <= _c2; _c++) {

function run_VM_SpriteExists(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var _name = run_vm_read_mem(vm, code[_base+0]);
    if (!is_string(_name) || _name == "") {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    
    var _native = asset_get_index(_name);
    if (_native != -1 && sprite_exists(_native)) {
        var _result = 1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    
    if (ds_map_exists(global._VM_sprite_temp_cache, _name)) {
        if (sprite_exists(global._VM_sprite_temp_cache[? _name])) {
        var _result = 1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    if (ds_map_exists(global._VM_sprite_cache, _name)) {
        if (sprite_exists(global._VM_sprite_cache[? _name])) {
        var _result = 1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    
    if (ds_map_exists(global._sprite_cache, _name)) {
        var _state = ds_map_exists(global._sprite_state, _name) ? global._sprite_state[? _name] : empty_load;
        if (_state != empty_load && sprite_exists(global._sprite_cache[? _name])) {
        var _result = 1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }


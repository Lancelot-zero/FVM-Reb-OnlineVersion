    if (_index < 0) return _ip;
    var _vm = vm;
    if (!ds_map_exists(_vm.arrays, _name)) ds_map_add(_vm.arrays, _name, []);
    var _arr = _vm.arrays[? _name];
    while (array_length(_arr) <= _index) array_push(_arr, 0);   
    _arr[_index] = _val;

    return _ip;
}



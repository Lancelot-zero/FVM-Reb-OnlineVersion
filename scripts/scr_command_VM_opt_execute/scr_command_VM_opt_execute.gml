    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var name = run_vm_read_mem(vm, code[_base+0]);
    var step = run_vm_read_mem(vm, code[_base+1]);
    var _spr = -1;
    if (ds_map_exists(global._sprite_cache, name)) {
        _spr = global._sprite_cache[? name];
    } else {
        _spr = get_load_sprite(name);
    }
    global.map_sprite_target = _spr;
    global.map_fade_alpha = 0;
    if (step > 0) global.map_fade_step = step;

    return _ip;
}


function run_VM_SetDrawSlot(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var slot = run_vm_read_mem(vm, code[_base+0]);
    var sprite = run_vm_read_mem(vm, code[_base+1]);
    var _x = run_vm_read_mem(vm, code[_base+2]);
    var _y = run_vm_read_mem(vm, code[_base+3]);
    var alpha = run_vm_read_mem(vm, code[_base+4]);

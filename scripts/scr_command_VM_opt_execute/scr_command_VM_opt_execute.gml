function run_VM_ClearPlants(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var col = run_vm_read_mem(vm, code[_base+0]);
    var row = run_vm_read_mem(vm, code[_base+1]);
    var _c1 = (col == -1) ? 0 : col;
    var _c2 = (col == -1) ? global.grid_cols - 1 : col;
    var _r1 = (row == -1) ? 0 : row;
    var _r2 = (row == -1) ? global.grid_rows - 1 : row;
    for (var _r = _r1; _r <= _r2; _r++) {
        for (var _c = _c1; _c <= _c2; _c++) {
            var _list = ds_grid_get(global.grid_plants, _c, _r);
            for (var _i = ds_list_size(_list) - 1; _i >= 0; _i--) {
                var _plant = ds_list_find_value(_list, _i);
                if (instance_exists(_plant) && _plant.plant_id == "player") continue;
                card_destroyed(_plant);
                instance_destroy(_plant);
            }
        }
    }

    return _ip;
}


function run_VM_Random(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var _min = run_vm_read_mem(vm, code[_base+0]);
    var _max = run_vm_read_mem(vm, code[_base+1]);
    var _range = _max - _min + 1;
    if (_range <= 0) {
        var _result = _min;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    
    var _vm = vm;
    var _s = _vm.rng_state;
    if (_s == 0) _s = 0x9E3779B9;
    _s ^= (_s << 13) & 0xFFFFFFFF;
    _s &= 0xFFFFFFFF;
    _s ^= _s >> 17;
    _s &= 0xFFFFFFFF;
    _s ^= (_s << 5) & 0xFFFFFFFF;
    _s &= 0xFFFFFFFF;
    _vm.rng_state = _s;
    {
        var _result = _min + (_s mod _range);
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }

    return _ip;
}



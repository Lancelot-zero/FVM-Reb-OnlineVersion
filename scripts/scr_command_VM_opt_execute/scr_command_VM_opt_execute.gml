	var _frames = run_vm_read_mem(vm, code[_base+1]);
	if (is_undefined(_frames) || _frames <= 0) _frames = 1;
	if (ds_map_exists(global._VM_sprite_cache, _name))
		{
        var _result = global._VM_sprite_cache[? _name];
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
	var _spr = sprite_add(_name, _frames, false, false, 0, 0);
	if (_spr == -1) {
        var _result = -1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
	ds_map_add(global._VM_sprite_cache, _name, _spr);
	{
        var _result = _spr;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }

    return _ip;
}



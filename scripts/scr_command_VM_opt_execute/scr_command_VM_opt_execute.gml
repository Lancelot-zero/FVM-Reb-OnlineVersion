    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var _msg = "";
    var _dur = 120;
    var _has_dur = (opt_number >= 2);          // 只传 1 个参数时没有时长，用默认值
    var _last = opt_number - 1;
    for (var _n = 0; _n < opt_number; _n++) {
        if (_has_dur && _n == _last) {
            _dur = run_vm_read_mem(vm, code[_base+_n]);   // 最后一个参数 = 时长（帧）
        } else {
            _msg += string(run_vm_read_mem(vm, code[_base+_n]));
        }
    }
    show_notice(_msg, _dur);

    return _ip;
}



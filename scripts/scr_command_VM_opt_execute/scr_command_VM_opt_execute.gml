    var _vm = vm;
    if (!ds_map_exists(_vm.arrays, _name)) {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    var _arr = _vm.arrays[? _name];
    if (_index < 0 || _index >= array_length(_arr)) {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    {
        var _result = _arr[_index];

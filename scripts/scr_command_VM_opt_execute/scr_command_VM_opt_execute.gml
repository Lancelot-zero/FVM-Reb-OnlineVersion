function run_VM_SetPlatformParams(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var plat_id = run_vm_read_mem(vm, code[_base+0]);
    var axis = run_vm_read_mem(vm, code[_base+1]);
    var distance = run_vm_read_mem(vm, code[_base+2]);
    var idle = run_vm_read_mem(vm, code[_base+3]);
    var _direction = run_vm_read_mem(vm, code[_base+4]);
    if (plat_id < 0) {
        var _real = ds_map_find_value(global._VM_id_to_real, -plat_id);
        if (is_undefined(_real)) return _ip;
        plat_id = _real;
    }
    var _plat = plat_id;
    if (!instance_exists(_plat) || _plat.object_index != obj_platform) return _ip;
    
    var _is_x = (_plat.move_axis == "x");
    _plat.start_col += (_is_x ? _plat.current_offset : 0);
    _plat.start_row += (!_is_x ? _plat.current_offset : 0);
    _plat.current_offset = 0;
    
    _plat.move_axis = (axis == 0) ? "y" : "x";
    _plat.move_distance = distance;
    _plat.boundary_idle_duration = idle;
    _plat.move_direction = _direction;

    return _ip;
}


function run_VM_SetMapBackground(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;

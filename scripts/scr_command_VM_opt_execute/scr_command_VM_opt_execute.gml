function run_vm_read_mem(vm, addr) {
    var _type = vm.mem_type[addr];
    if (_type == VM_TYPE_STRING) {
        var _idx = vm.mem_val[addr];
        if (_idx >= 0 && _idx < array_length(vm.strings))
            return vm.strings[_idx];
        return "";
    }
    return vm.mem_val[addr];
}

function run_VM_BanCard(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var card_id = run_vm_read_mem(vm, code[_base+0]);
    global.banned_cards_online[? card_id] = true;

    return _ip;
}


function run_VM_SetCardLevelCap(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;

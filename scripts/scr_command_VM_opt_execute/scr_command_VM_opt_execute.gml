    if (!instance_exists(_inst)) {
        var _result = -1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    if (!variable_instance_exists(_inst, _name)) {
        var _result = -1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    var _arr = variable_instance_get(_inst, _name);
    if (!is_array(_arr)) {
        var _result = -1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    if (_k < 0 || _k >= array_length(_arr)) {
        var _result = -1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    array_delete(_arr, _k, 1);
    variable_instance_set(_inst, _name, _arr);
    {
        var _result = 1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }

    return _ip;
}



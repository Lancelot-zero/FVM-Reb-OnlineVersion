function run_VM_RunStep(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var _inst = run_vm_read_mem(vm, code[_base+0]);
    var _times = run_vm_read_mem(vm, code[_base+1]);
    if (_inst < 0) {
        var _real = ds_map_find_value(global._VM_id_to_real, -_inst);
        if (is_undefined(_real)) {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
        _inst = _real;
    }
    if (!instance_exists(_inst)) {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    if (is_undefined(_times) || _times < 1) _times = 1;
    if (_times > 60) _times = 60;

    if (!variable_global_exists("_VM_step_running")) global._VM_step_running = ds_map_create();
    var _map = global._VM_step_running;
    if (ds_map_find_value(_map, _inst) != undefined) {
        var _result = 0;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }   
    _map[? _inst] = true;

    var _n = 0;
    try {
        for (var _k = 0; _k < _times; _k++) {
            if (!instance_exists(_inst)) break;
            with (_inst) event_perform(ev_step, ev_step_begin);
            if (!instance_exists(_inst)) break;
            with (_inst) event_perform(ev_step, ev_step_normal);
            if (!instance_exists(_inst)) break;
            with (_inst) event_perform(ev_step, ev_step_end);
            _n += 1;
        }
    } finally {
        ds_map_delete(_map, _inst);
    }
    {
        var _result = _n;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }

    return _ip;
}



function run_VM_CallFunc(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var _name = run_vm_read_mem(vm, code[_base+0]);
    if (!variable_global_exists("_VM_call_dict")) {
        var _result = undefined;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    var _dict = global._VM_call_dict;
    if (!ds_map_exists(_dict, _name)) {
        show_debug_message("[VM_CallFunc] 字典里没有这个函数: " + string(_name) + "（VM_FuncExists 可先判断）");
        {
        var _result = undefined;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    
    var _ent = _dict[? _name];
    var _n = max(0, opt_number - 1);              // 第 0 个是函数名，剩下都是实参
    var _addrs = array_create(_n);
    for (var _i = 0; _i < _n; _i++) {
        _addrs[_i] = code[_base + 1 + _i];
    }
    var _args = _addrs;                           // raw = false：地址原样转发，不复制
    if (_ent[$ "raw"]) {                          // raw = true：地址 → 值
        _args = array_create(_n);
        for (var _i = 0; _i < _n; _i++) {
            _args[_i] = run_vm_read_mem(vm, _addrs[_i]);
        }
    }
    // 直接调函数引用，绕开 script_execute_ext（动态派发 + 数组展开，开销大）。
    // 常见参数个数用 switch 展开成普通调用；超过 8 个才退回 execute_ext。
    var _fn = _ent[$ "fn"];
    var _result;
    switch (_n) {
        case 0: _result = _fn(); break;
        case 1: _result = _fn(_args[0]); break;
        case 2: _result = _fn(_args[0], _args[1]); break;
        case 3: _result = _fn(_args[0], _args[1], _args[2]); break;
        case 4: _result = _fn(_args[0], _args[1], _args[2], _args[3]); break;
        case 5: _result = _fn(_args[0], _args[1], _args[2], _args[3], _args[4]); break;
        case 6: _result = _fn(_args[0], _args[1], _args[2], _args[3], _args[4], _args[5]); break;
        case 7: _result = _fn(_args[0], _args[1], _args[2], _args[3], _args[4], _args[5], _args[6]); break;
        case 8: _result = _fn(_args[0], _args[1], _args[2], _args[3], _args[4], _args[5], _args[6], _args[7]); break;
        default: _result = script_execute_ext(_fn, _args); break;
    }
    if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
    return _ip;
}



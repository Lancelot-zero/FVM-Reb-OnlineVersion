function run_VM_ShellPrint(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var _msg = "";
    for (var _n = 0; _n < opt_number; _n++) {
        var _addr = code[_base+_n];
        if (!is_undefined(_addr)) _msg += string(run_vm_read_mem(vm, _addr));
    }
    shell_print(_msg);

    return _ip;
}


function run_VM_ShowNotice(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;

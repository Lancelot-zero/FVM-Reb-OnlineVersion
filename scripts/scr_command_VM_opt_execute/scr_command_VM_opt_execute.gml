function VM_Execute_code_opt(vm, code, name) {

    try {
        var _n  = array_length(code);
        var _ip = 0;
        // 内存数组一次取出、循环内复用（一次块执行期间不会被重建）
        var _mt = vm.mem_type;
        var _mv = vm.mem_val;

        while (_ip < _n) {
            var _op = code[_ip];
            _ip += 1;

            // ── 18 及以上 = 函数专用操作码（VM_Decode 生成 18 + 函数id）→ 查表派发 ──
            if (_op >= VM_OP_FUNC_BASE) {
                var _fn = global._vm_opt_run_funcs[_op];
                if (is_undefined(_fn)) {
                    shell_print("VM Error: 未知操作码 " + string(_op));
                    return -1;
                }
                _ip = _fn(vm, code, _ip);
                if (_ip < 0) return -1;
            } else {
                // ── 1~17 = 核心操作码，就地展开（原来每条都要走一次 _fn(vm, code, _ip)）──
                switch (_op) {
                    case VM_OP_ASSIGN: {
                        var _dst = code[_ip];
                        _mt[_dst] = code[_ip + 1];
                        _mv[_dst] = code[_ip + 2];
                        _ip += 3;
                        break;
                    }
                    case VM_OP_COPY: {
                        var _dst = code[_ip];
                        var _src = code[_ip + 1];
                        _ip += 2;
                        _mt[_dst] = _mt[_src];
                        _mv[_dst] = _mv[_src];
                        break;
                    }
                    case VM_OP_ADD: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        var _res = _mv[_a] + _mv[_b];
                        _mt[_d] = (_mt[_a] == VM_TYPE_FLOAT || _mt[_b] == VM_TYPE_FLOAT) ? VM_TYPE_FLOAT : VM_TYPE_INT;
                        _mv[_d] = _res;
                        break;
                    }
                    case VM_OP_SUB: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = (_mt[_a] == VM_TYPE_FLOAT || _mt[_b] == VM_TYPE_FLOAT) ? VM_TYPE_FLOAT : VM_TYPE_INT;
                        _mv[_d] = _mv[_a] - _mv[_b];
                        break;
                    }
                    case VM_OP_MUL: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = (_mt[_a] == VM_TYPE_FLOAT || _mt[_b] == VM_TYPE_FLOAT) ? VM_TYPE_FLOAT : VM_TYPE_INT;
                        _mv[_d] = _mv[_a] * _mv[_b];
                        break;
                    }
                    case VM_OP_DIV: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        var _int_div = (_mt[_a] != VM_TYPE_FLOAT && _mt[_b] != VM_TYPE_FLOAT);
                        if (_mv[_b] == 0) {
                            _mt[_d] = _int_div ? VM_TYPE_INT : VM_TYPE_FLOAT;
                            _mv[_d] = 0;
                        } else if (_int_div) {
                            _mt[_d] = VM_TYPE_INT;
                            // real()：div 返回 int64，is_real() 对 int64 判 false，
                            // 直接存进槽会让卡里的 is_real 判断全废。语义不变（同 C 的 int /，向零取整）
                            _mv[_d] = real(_mv[_a] div _mv[_b]);
                        } else {
                            _mt[_d] = VM_TYPE_FLOAT;
                            _mv[_d] = _mv[_a] / _mv[_b];
                        }
                        break;
                    }
                    case VM_OP_MOD: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        // real()：mod 返回 int64，同上。除数 0 显式返回 0（C 的 % 在除数为 0 时未定义）
                        _mv[_d] = real((_mv[_b] != 0) ? _mv[_a] mod _mv[_b] : 0);
                        break;
                    }
                    case VM_OP_EQ: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        _mv[_d] = (_mv[_a] == _mv[_b]) ? 1 : 0;
                        break;
                    }
                    case VM_OP_NEQ: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        _mv[_d] = (_mv[_a] != _mv[_b]) ? 1 : 0;
                        break;
                    }
                    case VM_OP_GT: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        _mv[_d] = (_mv[_a] > _mv[_b]) ? 1 : 0;
                        break;
                    }
                    case VM_OP_GTE: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        _mv[_d] = (_mv[_a] >= _mv[_b]) ? 1 : 0;
                        break;
                    }
                    case VM_OP_LT: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        _mv[_d] = (_mv[_a] < _mv[_b]) ? 1 : 0;
                        break;
                    }
                    case VM_OP_LTE: {
                        var _d = code[_ip];
                        var _a = code[_ip + 1];
                        var _b = code[_ip + 2];
                        _ip += 3;
                        _mt[_d] = VM_TYPE_INT;
                        _mv[_d] = (_mv[_a] <= _mv[_b]) ? 1 : 0;
                        break;
                    }
                    case VM_OP_CALL: {
                        var _func_id = code[_ip];
                        var _arg_count = code[_ip + 1];
                        var _dst = code[_ip + 2];
                        _ip += 3;
                        var _args = array_create(_arg_count);
                        for (var _i = 0; _i < _arg_count; _i++) {
                            _args[_i] = code[_ip + _i];
                        }
                        _ip += _arg_count;

                        if (_func_id < 0 || _func_id >= array_length(vm.functions)) {
                            shell_print("VM Error: 未注册函数ID " + string(_func_id));
                            return -1;
                        }

                        var _fn = vm.functions[_func_id];
                        var _result = script_execute_ext(_fn, _args);

                        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
                        break;
                    }
                    case VM_OP_IF: {
                        var _cond_addr = code[_ip];
                        var _true_ip = code[_ip + 1];
                        var _false_ip = code[_ip + 2];
                        _ip += 3;

                        var _cond = _mv[_cond_addr];
                        if (!is_real(_cond)) _cond = 0;
                        _ip = (_cond != 0) ? _true_ip : _false_ip;
                        break;
                    }
                    case VM_OP_JMP: {
                        _ip = code[_ip];
                        break;
                    }
                    case VM_OP_HALT: {
                        _ip = array_length(code);
                        break;
                    }
                    default: {
                        shell_print("VM Error: 未知操作码 " + string(_op));
                        return -1;
                    }
                }
            }
        }

        return 0;

    } catch (_err) {
        mod_error_report(vm, name, _ip, _err);
        if (variable_global_exists("_VM_strict") && global._VM_strict) throw _err;
        return -1;
    }
}
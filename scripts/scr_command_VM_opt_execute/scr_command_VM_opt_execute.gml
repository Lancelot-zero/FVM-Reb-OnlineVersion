function run_VM_GetProp(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

    var inst_id = run_vm_read_mem(vm, code[_base+0]);
    var prop = run_vm_read_mem(vm, code[_base+1]);
    
    if (inst_id == 0) {
        if (variable_global_exists(prop)) {
        var _result = variable_global_get(prop);
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
        {
        var _result = undefined;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    if (inst_id < 0) {
        var _real = ds_map_find_value(global._VM_id_to_real, -inst_id);
        if (is_undefined(_real)) {
        var _result = undefined;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
        inst_id = _real;
    }
    if (!instance_exists(inst_id)) {
        var _result = undefined;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    
    if (prop == "object_name") {
        {
        var _result = object_get_name(inst_id.object_index);
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    
    if (prop == "mouse_id" && (!variable_instance_exists(inst_id, prop)||
		variable_instance_exists(inst_id, prop)&&variable_instance_get(inst_id, prop)=""
	)) {
        {
        var _result = string_delete(object_get_name(inst_id.object_index), 1, 4);
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
    }
    {
        var _result = variable_instance_get(inst_id, prop);
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }

    return _ip;
}



function run_VM_Slot_add(vm, code, _ip) {
    var opt_number = code[_ip]; _ip += 1;
    var _mt = vm.mem_type;
    var _mv = vm.mem_val;
    var _dst = code[_ip]; _ip += 1;
    var _base = _ip;
    _ip += opt_number;

	var card_id = run_vm_read_mem(vm, code[_base+0]);
	
	var card_data = deck_get_card_data(card_id, 0);
	if (card_data == noone) {
        var _result = -1;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
	var n = array_length(global._VM_conveyor_belt_arr);
	if(n>14){
        var _result = noone;
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }
	var inst = instance_create_depth(535 + 15 * 90, 90, -5, obj_card_slot);
	inst.cost = 0;
	inst.cooldown = 0;
	inst.card_obj = card_data[? "obj"];
	inst.card_spr = card_data[? "sprite"];
	inst.place_preview = card_data[? "place_preview"]
	inst.description = card_data[? "description"];
	inst.slot_index = n + 1;
	inst.card_id = card_id;
	inst.shape = card_data[? "shape"]; 
	inst.depth = -2000
	
	array_push(global._VM_conveyor_belt_arr,inst);
	{
        var _result = real(inst.id);
        if (_dst != VM_DST_VOID) vm_store_result(vm, _mt, _mv, _dst, _result);
        return _ip;
    }

    return _ip;
}


